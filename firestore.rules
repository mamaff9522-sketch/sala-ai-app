rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to verify user ownership
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ID validation guard
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Admin = the seed email, an email an existing admin added on config/admins,
    // or a user doc whose role an existing admin already set. A normal user cannot write role or this list.
    function isListedAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/admins)
        && get(/databases/$(database)/documents/config/admins).data.emails is list
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mama.ff9522@gmail.com' ||
        isListedAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /users/{userId} {
      // Only the user themselves or an admin can read user profile data
      allow read: if isOwner(userId) || isAdmin();
      // User can create their own profile at signup only with a zero balance. Admins grant credits later.
      // or Admin can create
      allow create: if isValidId(userId) && (
        isAdmin() || (
          isOwner(userId) &&
          (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
          (!('isLocked' in request.resource.data) || request.resource.data.isLocked == false) &&
          (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
          (!('credits' in request.resource.data) || request.resource.data.credits == 0) &&
          (!('remainingCredits' in request.resource.data) || request.resource.data.remainingCredits == 0) &&
          !('lastTopupAmount' in request.resource.data)
        )
      );

      // Admin can update all fields; regular owner cannot change role, status, isLocked, or any credit fields
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isLocked', 'status', 'credits', 'remainingCredits',
          'lastTopupAmount', 'lastTopupAt', 'lastPaymentMethod'
        ])
      );
      // Only admin can delete users
      allow delete: if isAdmin();

      // User characters subcollection
      match /characters/{characterId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create, update: if isSignedIn() && isOwner(userId) && isValidId(characterId);
        allow delete: if isSignedIn() && isOwner(userId);
      }

      // User locations subcollection
      match /locations/{locationId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create, update: if isSignedIn() && isOwner(userId) && isValidId(locationId);
        allow delete: if isSignedIn() && isOwner(userId);
      }
    }

    // Top-level characters collection (legacy / fallback storage)
    // Only the signed-in owner (or an admin) may read/update/delete; create must stamp own uid.
    match /characters/{characterId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(characterId) && (isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid));
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Top-level locations collection (legacy / fallback storage)
    match /locations/{locationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(locationId) && (isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid));
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Chat rooms: only members can read and write.
    // sala-everyone is the one shared room. Any signed-in user may get that
    // room and create text messages in it without being in memberIds.
    // List queries stay member-only, so this does not open every room.
    match /chatRooms/{roomId} {
      function signedMember(data) {
        return isSignedIn() && data.memberIds is list && request.auth.uid in data.memberIds;
      }

      function isEveryoneRoom() {
        return roomId == 'sala-everyone';
      }

      allow get: if (isEveryoneRoom() && isSignedIn()) || signedMember(resource.data);
      allow list: if signedMember(resource.data);
      allow create: if isValidId(roomId)
        && signedMember(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds.size() > 0
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.keys().hasAll(['memberIds', 'createdBy', 'name']);
      allow update: if !isEveryoneRoom()
        && signedMember(resource.data)
        && signedMember(request.resource.data);
      allow delete: if !isEveryoneRoom()
        && isSignedIn()
        && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        function inRoom() {
          return isSignedIn() && (
            roomId == 'sala-everyone' ||
            request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberIds
          );
        }
        allow read: if inRoom();
        allow create: if inRoom()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Emails an existing admin added. The seed admin is hardcoded above and does not depend on this doc.
    match /config/admins {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 50;
      allow delete: if false;
    }

    // Everything else is denied by default (Firestore rules are deny-by-default).
  }
}

